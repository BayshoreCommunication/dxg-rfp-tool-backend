# Backend environment for the local Docker stack. Loaded through RFPILOT_ENV_FILE, which makes
# config/env.ts skip .env and .env.local. Every value here is a local-only placeholder: none of
# them is a real credential, and none of these services is reachable off this machine.
NODE_ENV=development
PORT=8100
FRONTEND_URL=http://localhost:3100
BACKEND_URL=http://localhost:8100
ADMIN_FRONTEND_URL=http://localhost:3101
CRON_ENABLED=true

MONGODB_URL=mongodb://localhost:47017/rfpilot_local?replicaSet=rs0
MONGODB_DB_NAME=rfpilot_local

JWT_SECRET=local-stack-jwt-secret-not-for-any-real-environment
JWT_ISSUER=rfpilot
JWT_AUDIENCE=rfpilot-users
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30
OTP_PEPPER=local-stack-otp-pepper-not-for-any-real-environment
BFF_SHARED_SECRET=local-stack-bff-shared-secret-32-characters-minimum
ADMIN_SIGNUP_SECRET=local-stack-admin-signup-secret
TWO_FACTOR_ENCRYPTION_KEY=6c6f63616c2d737461636b2d32666b65792d6e6f742d666f722d7265616c2121
TWO_FACTOR_ISSUER=RFPilot (local)
TWO_FACTOR_SSO_POLICY=challenge
SSO_SECRET_KEY=6c6f63616c2d737461636b2d73736f6b65792d6e6f742d666f722d7265616c2121
DOMAIN_VERIFICATION_METHODS=dns_txt
PUBLIC_GRANTS_ENFORCED=true
PASSWORD_SIGN_IN_ENABLED=true

# Mailpit: every email lands in http://127.0.0.1:48025, nothing leaves the machine.
SMTP_HOST=127.0.0.1
SMTP_PORT=41025
SMTP_MAIL=rfpilot@local.test
SMTP_USER=rfpilot
SMTP_PASSWORD=local

# No S3 stand-in yet: file uploads (logos, attachments, vendor documents) are unavailable on
# the local stack. Document ingestion stays off.
DOCUMENT_INGESTION_ENABLED=false
VENDOR_UPLOAD_SCAN_REQUIRED=false
VENDOR_STRUCTURED_RESPONSES_ENABLED=true

# Postgres: migrations run as the superuser; the API runs as rfpilot_app, a plain role that is
# bound by row-level security, so tenant-isolation bugs show up locally instead of being hidden.
POSTGRES_FOUNDATION_ENABLED=true
POSTGRES_URL=postgres://rfpilot_app:rfpilot_local@127.0.0.1:45432/rfpilot_local
POSTGRES_MIGRATION_URL=postgres://postgres:rfpilot_local@127.0.0.1:45432/rfpilot_local
POSTGRES_SSL=false
PROPOSAL_REFERENCE_DUAL_WRITE_ENABLED=false

DURABLE_JOBS_ENABLED=true
REDIS_URL=redis://127.0.0.1:46379

# AI stays off. To try an AI feature, set AI_ENVIRONMENT and that feature's flags in a copy of
# this file; never put a provider key in the committed file.
AI_ENVIRONMENT=
OPENAI_API_KEY=
AI_GATEWAY_ENABLED=false
AI_ASSISTANT_ENABLED=false
CONVERSATIONS_ENABLED=false
OBSERVABILITY_ENABLED=false
