# Backend environment for the tenancy-migration rehearsal stack (deploy/rehearsal, ORG-501).
# Loaded through RFPILOT_ENV_FILE, which makes config/env.ts skip .env and .env.local, so a
# rehearsal can never reach a shared or production database. Every value is a local-only
# placeholder for containers bound to loopback; none is a real credential.
NODE_ENV=development

MONGODB_URL=mongodb://localhost:37017/rfpilot_rehearsal?replicaSet=rs0
MONGODB_DB_NAME=rfpilot_rehearsal
DEFAULT_ORGANIZATION_SLUG=dxg

# As in production, the migration connects as the role that owns the tables: no superuser and no
# BYPASSRLS. The fixture builder creates that role and is the only thing that uses the superuser.
POSTGRES_FOUNDATION_ENABLED=true
POSTGRES_MIGRATION_URL=postgres://rfpilot_migrator:rfpilot_rehearsal@127.0.0.1:35432/rfpilot_rehearsal
POSTGRES_URL=postgres://rfpilot_migrator:rfpilot_rehearsal@127.0.0.1:35432/rfpilot_rehearsal
REHEARSAL_POSTGRES_SUPERUSER_URL=postgres://postgres:rfpilot_rehearsal@127.0.0.1:35432/rfpilot_rehearsal
POSTGRES_SSL=false

JWT_SECRET=rehearsal-stack-jwt-secret-not-for-any-real-environment
OTP_PEPPER=rehearsal-stack-otp-pepper-not-for-any-real-environment
AI_ENVIRONMENT=
DURABLE_JOBS_ENABLED=false
CRON_ENABLED=false
OBSERVABILITY_ENABLED=false
