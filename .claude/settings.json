{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint*)",
      "Bash(npm run type-check*)",
      "Bash(npm test*)",
      "Bash(npm run test*)",
      "Bash(npm run ci*)",
      "Bash(npm run build*)",
      "Bash(npx eslint *)",
      "Bash(npx tsc *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git worktree list*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)",
      "Bash(npm run contracts:*)",
      "Bash(npm run migration:check*)",
      "Bash(npm run integration:*)",
      "Bash(npm run test:integration*)",
      "Bash(INTEGRATION=1 node --test *)",
      "Bash(npm run stack:up*)",
      "Bash(npm run stack:down*)",
      "Bash(npm run stack:migrate*)",
      "Bash(npm run stack:seed*)",
      "Bash(npm run stack:dev*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.production.local)",
      "Read(./.env.development)",
      "Read(./.env.development.local)",
      "Read(./.env.test.local)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin --force*)",
      "Bash(git push origin -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(npm run migrate:postgres:prod*)",
      "Bash(npm run purge:*)",
      "Bash(npm run create-super-user*)",
      "Bash(npm run eval:assistant:live*)",
      "Bash(npx ts-node scripts/purge*)",
      "Bash(ts-node scripts/purge*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr create*)",
      "Bash(npm run migrate:*)",
      "Bash(npm run backfill:*)",
      "Bash(npm run platform:*)",
      "Bash(npm run retention:*)",
      "Bash(npm run release:*)",
      "Bash(npm run stack:reset*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-file.sh\"",
            "timeout": 60,
            "statusMessage": "ESLint on changed file"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/typecheck-on-stop.sh\"",
            "timeout": 180,
            "statusMessage": "Type-checking edited TypeScript"
          }
        ]
      }
    ]
  }
}
