# RFPilot backend configuration
# Copy to .env and provide only the values required by your environment.
# Keep secrets out of git. .env.local is optional and overrides .env locally.

# Application
NODE_ENV=development
PORT=8000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
# The API's in-process cron jobs (proposal expiration, archive purge,
# retention sweep) have no cross-replica locking. When running more than one
# API instance, exactly one keeps the default; every other instance must set
# CRON_ENABLED=false.
CRON_ENABLED=true

# MongoDB and authentication
MONGODB_URL=mongodb://127.0.0.1:27017/dxg_rfp_tool_db
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=rfpilot
JWT_AUDIENCE=rfpilot-users
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30
OTP_PEPPER=replace-with-a-different-long-random-secret
BFF_SHARED_SECRET=replace-with-the-same-long-random-secret-used-by-both-next-apps
ADMIN_SIGNUP_SECRET=replace-with-a-separate-admin-bootstrap-secret
PUBLIC_GRANTS_ENFORCED=true
# Google sign-in: OAuth client ID used as the expected audience when verifying
# Google idTokens on POST /api/auth/google. Must be the SAME client ID the
# dashboard uses (its GOOGLE_CLIENT_ID). The client secret is not needed here.
GOOGLE_CLIENT_ID=

# Email (AWS: SES SMTP — SMTP_USER/SMTP_PASSWORD are the IAM-derived SMTP
# credentials and SMTP_MAIL is the verified From address. SMTP_USER is
# optional for providers that authenticate with the mail address itself.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_MAIL=no-reply@example.com
SMTP_USER=
SMTP_PASSWORD=replace-me

# Application asset storage (logos, avatars, proposal support documents,
# vendor-response documents). Two interfaces over the same code path:
#
# ASSET_STORAGE_* — provider-neutral, preferred. With ASSET_STORAGE_BUCKET set
# and no endpoint, targets native AWS S3; omit KEY/SECRET entirely to use the
# SDK default credential chain (ECS task role). Public-read ACLs are NOT
# applied on this interface (S3 Block Public Access rejects them) — set
# ASSET_STORAGE_PUBLIC_URL_BASE to the CDN that fronts public assets.
ASSET_STORAGE_BUCKET=
ASSET_STORAGE_REGION=
ASSET_STORAGE_KEY=
ASSET_STORAGE_SECRET=
ASSET_STORAGE_ENDPOINT=
ASSET_STORAGE_PUBLIC_URL_BASE=
ASSET_STORAGE_PUBLIC_ACL=false
#
# DO_SPACES_* — legacy DigitalOcean Spaces fallback, unchanged behavior:
# derived endpoint, static keys required, public-read ACL on public assets.
DO_SPACES_BUCKET=
DO_SPACES_REGION=
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_FOLDER_NAME=DXG-RFP-Tool

# PostgreSQL AI domain
POSTGRES_FOUNDATION_ENABLED=false
POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:5432/rfpilot
POSTGRES_MIGRATION_URL=postgresql://postgres:postgres@127.0.0.1:5432/rfpilot
# POSTGRES_SSL=true verifies the server certificate. Amazon RDS certificates
# chain to the RDS root CA, which is not in Node's default trust store —
# provide it via NODE_EXTRA_CA_CERTS=/path/to/rds-global-bundle.pem.
POSTGRES_SSL=false
POSTGRES_POOL_MAX=10
POSTGRES_CONNECT_TIMEOUT_MS=5000
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_STATEMENT_TIMEOUT_MS=15000
PROPOSAL_REFERENCE_DUAL_WRITE_ENABLED=false

# Durable jobs and Redis
DURABLE_JOBS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379
JOB_MAX_ATTEMPTS=5
JOB_BACKOFF_BASE_MS=5000
JOB_LEASE_SECONDS=90
SOURCE_SECURITY_CONCURRENCY=2

# Private document ingestion and malware scanning.
# With DOCUMENT_STORAGE_BUCKET set and no endpoint, the client targets native
# AWS S3; omit KEY/SECRET entirely to use the SDK default credential chain
# (ECS task role). An explicit endpoint (MinIO, Spaces) always wins. Without
# DOCUMENT_STORAGE_BUCKET, the legacy DO_SPACES_* fallback applies and static
# keys are required.
DOCUMENT_INGESTION_ENABLED=false
DOCUMENT_STORAGE_BUCKET=
DOCUMENT_STORAGE_REGION=
DOCUMENT_STORAGE_ENDPOINT=
DOCUMENT_STORAGE_KEY=
DOCUMENT_STORAGE_SECRET=
DOCUMENT_STORAGE_FORCE_PATH_STYLE=false
DOCUMENT_SCANNER_MODE=clamav
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
# Vendor uploads are the only unauthenticated file intake. Production fails
# closed even when this variable is omitted; local/test defaults to a logged
# skip when no scanner exists. Keep this true in production.
VENDOR_UPLOAD_SCAN_REQUIRED=true


# POST /api/extract-proposal — the legacy wizard extraction path. It calls a
# live provider, so it is deny-by-default like the rest of the AI surface and
# also honours LIVE_AI_KILL_SWITCH and LIVE_AI_KILL_SWITCH_LEGACYEXTRACTION.
# It is NOT equivalent to governed extraction: uploads reach the provider
# unscanned, no ai_provider_attempts row is written, and output carries no
# citations. Retire it once governed extraction covers arrays and rooms.
LEGACY_EXTRACTION_ENABLED=false
LEGACY_EXTRACTION_MODEL=gpt-4o

# Retention enforcement. retention_until has always been written on every AI
# run and never acted on, so expired evidence and draft prose persisted
# indefinitely. Turning the sweep ON only makes it REPORT what it would remove;
# RETENTION_SWEEP_APPLY is the separate decision to actually delete. Run it in
# dry-run against staging and check the counts before ever setting APPLY.
RETENTION_SWEEP_ENABLED=false
RETENTION_SWEEP_APPLY=false
RETENTION_SWEEP_BATCH=500

# Conversational requirement extraction. Typed turns are batched into a
# transcript segment and materialised as a scanned private source, which then
# chains extraction. Batching is what makes corrections safe: a later "sorry,
# 350" must land in the SAME run as the 300 it corrects so the conflict
# detector can see them disagree. Also needs PROPOSAL_CONTEXT_ENABLED,
# LIVE_AI_PROPOSAL_SOURCE_ENABLED and DOCUMENT_INGESTION_ENABLED to reach
# extraction; without them a segment is still captured as a source.
CONVERSATION_EXTRACTION_ENABLED=false
CONVERSATION_EXTRACT_IDLE_MS=45000
CONVERSATION_EXTRACT_MAX_TURNS=6
# One substantive turn at or above this length closes immediately instead of
# waiting for more turns. Shorter messages still batch for safe corrections.
CONVERSATION_EXTRACT_RICH_TURN_CHARS=240

# Governed AI runtime. Unset/disabled is deny-by-default.
AI_ENVIRONMENT=test
OPENAI_API_KEY=
AI_GATEWAY_ENABLED=false
CONVERSATIONS_ENABLED=false
AI_ASSISTANT_ENABLED=false
# Comma-separated 24-character organization IDs. Required in production.
# Use "*" only after explicit approval for an all-organization rollout.
AI_ASSISTANT_ALLOWED_ORGANIZATION_IDS=
AI_ASSISTANT_KILL_SWITCH=true
AI_ASSISTANT_MODEL=
AI_ASSISTANT_REASONING_EFFORT=none
AI_ASSISTANT_TEXT_VERBOSITY=low
AI_ASSISTANT_MAX_INPUT_TOKENS=12000
AI_ASSISTANT_MAX_OUTPUT_TOKENS=1200
AI_ASSISTANT_MAX_HISTORY_MESSAGES=30
AI_ASSISTANT_MAX_KNOWLEDGE_RESULTS=8
AI_ASSISTANT_REQUESTS_PER_15_MINUTES=30
AI_ASSISTANT_ORG_REQUESTS_PER_15_MINUTES=300
AI_ASSISTANT_MAX_ACTIVE_STREAMS_PER_USER=1
AI_ASSISTANT_MAX_ACTIVE_STREAMS_PER_ORG=20
AI_ASSISTANT_ACTIVE_STREAM_LEASE_MS=120000
AI_ASSISTANT_STREAM_TIMEOUT_MS=45000
AI_ASSISTANT_HEARTBEAT_MS=15000
AI_ASSISTANT_PROVIDER_MAX_ATTEMPTS=2
AI_SAFETY_IDENTIFIER_SECRET=replace-with-a-long-random-secret
AI_ASSISTANT_ANALYTICS_ENABLED=false
AI_ANALYTICS_PSEUDONYM_KEY=replace-with-a-different-long-random-secret
# Phase 5 staging evaluation. Live mode remains deny-by-default.
AI_ASSISTANT_CANDIDATE_MODEL=gpt-5.6-terra
AI_ASSISTANT_EVAL_LIVE=false
AI_ASSISTANT_EVAL_MIN_CASE_PASS_RATE=0.90
AI_ASSISTANT_EVAL_P95_TTFT_MS=5000
AI_ASSISTANT_EVAL_P95_COMPLETION_MS=20000
AI_ASSISTANT_EVAL_P95_COST_USD=0.02
AI_ASSISTANT_EVAL_BUDGETS_APPROVED=false
# Required only when evaluating a model without a verified built-in price.
AI_ASSISTANT_EVAL_APPROVED_INPUT_USD_PER_MILLION=
AI_ASSISTANT_EVAL_APPROVED_OUTPUT_USD_PER_MILLION=
AI_ASSISTANT_EVAL_CANDIDATE_INPUT_USD_PER_MILLION=
AI_ASSISTANT_EVAL_CANDIDATE_OUTPUT_USD_PER_MILLION=
# Retention cleanup is independently deny-by-default. Keep all three false
# during normal deployment and pilot operation.
AI_RETENTION_PURGE_ENABLED=false
AI_RETENTION_POLICY_APPROVED=false
AI_RETENTION_PRODUCTION_EXECUTION_APPROVED=false
PROPOSAL_CONTEXT_ENABLED=false
PROPOSAL_CONTEXT_PROVIDER=mock
PROPOSAL_CONTEXT_MODEL=deterministic-v1
PROPOSAL_CONTEXT_RETENTION_DAYS=30
CANDIDATE_APPLICATION_ENABLED=false
PROPOSAL_DRAFT_ENABLED=false
# Download a reviewed draft as a standalone RFP document. Only sections a
# human accepted are included; it renders, it does not publish or send.
PROPOSAL_EXPORT_ENABLED=false
# Standalone HTML documents a planner can circulate outside the app.
VENDOR_ANALYSIS_EXPORT_ENABLED=false
INVESTMENT_EXPORT_ENABLED=false
PROPOSAL_DRAFT_PROVIDER=mock
PROPOSAL_WORKFLOW_ENABLED=false

# Live provider
LIVE_AI_PILOT_ENABLED=false
LIVE_AI_PROVIDER=openai
LIVE_AI_MODEL=gpt-5.4-mini-2026-03-17
LIVE_AI_SYNTHETIC_ENABLED=false
LIVE_AI_NON_CONFIDENTIAL_ENABLED=false
LIVE_AI_PROPOSAL_SOURCE_ENABLED=false
LIVE_AI_KILL_SWITCH=true
LIVE_AI_INPUT_TOKEN_LIMIT=32000
LIVE_AI_OUTPUT_TOKEN_LIMIT=4000

# Knowledge, guidance, pricing, and vendor analysis
KNOWLEDGE_INGESTION_ENABLED=false
KNOWLEDGE_REVIEW_ENABLED=false
KNOWLEDGE_INDEPENDENT_APPROVAL_REQUIRED=false
KNOWLEDGE_RETRIEVAL_ENABLED=false
KNOWLEDGE_RETRIEVAL_MODE=hybrid
KNOWLEDGE_EMBEDDING_PROVIDER=mock
KNOWLEDGE_EMBEDDING_MODEL=deterministic-v1
KNOWLEDGE_RETRIEVAL_MAX_RESULTS=20
KNOWLEDGE_RETRIEVAL_QUERY_TIMEOUT_MS=3000
KNOWLEDGE_IN_DRAFT_ENABLED=false
GUIDANCE_ENABLED=false
# Deterministic room specification recommendations. Generation never writes
# to the proposal; application fills EMPTY allowlisted room fields (filled
# fields are never overwritten) and the planner adjusts values in the form.
ROOM_RECOMMENDATIONS_ENABLED=false
HISTORICAL_INSIGHTS_ENABLED=false
PRICING_CORPUS_ENABLED=false
INVESTMENT_GUIDANCE_ENABLED=false
VENDOR_ANALYSIS_ENABLED=false

# Safe telemetry
OBSERVABILITY_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SERVICE_NAME=rfpilot-backend
OTEL_METRIC_EXPORT_INTERVAL_MS=60000
TELEMETRY_PSEUDONYM_KEY=replace-with-a-long-random-secret
APP_VERSION=development
