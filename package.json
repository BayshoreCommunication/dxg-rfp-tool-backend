{
  "name": "dxg-rfp-tool-backend",
  "version": "1.0.0",
  "description": "Backend API for DXG RFP Tool",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src contracts config/postgres.ts scripts/migrateProposalV1.ts scripts/migrateDxgOrganization.ts scripts/migrateOrganizationMemberships.ts scripts/migratePostgres.ts scripts/backfillPostgresProposalReferences.ts --max-warnings=0",
    "type-check": "tsc --noEmit",
    "test": "node --test --require ts-node/register tests/*.test.js",
    "contracts:generate": "node scripts/generateContracts.mjs",
    "contracts:check": "node scripts/generateContracts.mjs --check",
    "migration:check": "ts-node scripts/migrateProposalV1.ts --help && ts-node scripts/migrateDxgOrganization.ts --help && ts-node scripts/migrateOrganizationMemberships.ts --help && ts-node scripts/migratePostgres.ts help && ts-node scripts/backfillPostgresProposalReferences.ts --help",
    "ci": "npm run contracts:check && npm run lint && npm run type-check && npm run migration:check && npm test && npm run build",
    "migrate:proposal-v1": "ts-node scripts/migrateProposalV1.ts",
    "migrate:dxg-organization": "ts-node scripts/migrateDxgOrganization.ts",
    "migrate:organization-memberships": "ts-node scripts/migrateOrganizationMemberships.ts",
    "migrate:postgres": "ts-node scripts/migratePostgres.ts",
    "backfill:postgres-proposals": "ts-node scripts/backfillPostgresProposalReferences.ts",
    "create-super-user": "ts-node scripts/createSuperUser.ts",
    "test-image-upload": "ts-node scripts/testImageUpload.ts"
  },
  "keywords": [
    "express",
    "typescript",
    "nodejs",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1007.0",
    "@langchain/core": "^1.1.36",
    "@langchain/openai": "^1.3.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "google-auth-library": "^10.9.0",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^1.2.37",
    "mammoth": "^1.12.0",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.3",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "resend": "^6.10.0",
    "sharp": "^0.34.5",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.10.6",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.20.0",
    "@vercel/node": "^3.0.0",
    "eslint": "^10.7.0",
    "json-schema-to-typescript": "^15.0.4",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.64.0"
  }
}
