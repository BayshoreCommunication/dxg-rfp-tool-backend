{
  "name": "dxg-rfp-tool-backend",
  "version": "1.0.0",
  "description": "Backend API for DXG RFP Tool",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon",
    "dev:proposal-context": "nodemon --exec 'env NODE_ENV=test ts-node' server.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('migrations','dist/migrations',{recursive:true})\"",
    "start": "node dist/server.js",
    "start:worker": "node dist/scripts/startDurableWorker.js",
    "start:dispatcher": "node dist/scripts/startDurableDispatcher.js",
    "migrate:postgres:prod": "node dist/scripts/migratePostgres.js",
    "lint": "eslint src contracts config/postgres.ts controller/platformAssistantController.ts controller/historicalInsightsController.ts routes/platformAssistantRoute.ts routes/historicalInsightsRoute.ts scripts/migrateProposalV1.ts scripts/migrateDxgOrganization.ts scripts/migrateOrganizationMemberships.ts scripts/migratePostgres.ts scripts/backfillPostgresProposalReferences.ts scripts/cleanupAssistantRetention.ts scripts/checkAssistantReleaseReadiness.ts scripts/verifyAuthRefreshE2E.ts scripts/verifyDocumentIngestionE2E.ts scripts/verifyDurableJobsE2E.ts scripts/verifyKnowledgeIngestionE2E.ts scripts/verifyKnowledgeReviewE2E.ts scripts/verifyKnowledgeRetrievalE2E.ts scripts/verifyProposalContextE2E.ts scripts/verifyRetentionSweepE2E.ts scripts/platformAssistantEval.ts scripts/startDurableWorker.ts scripts/startDurableDispatcher.ts scripts/startAiGatewayWorker.ts --max-warnings=0",
    "type-check": "tsc --noEmit",
    "test": "node --test --require ts-node/register tests/*.test.js",
    "contracts:generate": "node scripts/generateContracts.mjs",
    "contracts:check": "node scripts/generateContracts.mjs --check",
    "migration:check": "ts-node scripts/migrateProposalV1.ts --help && ts-node scripts/migrateDxgOrganization.ts --help && ts-node scripts/migrateOrganizationMemberships.ts --help && ts-node scripts/migratePostgres.ts help && ts-node scripts/backfillPostgresProposalReferences.ts --help && ts-node scripts/cleanupAssistantRetention.ts --help && ts-node scripts/checkAssistantReleaseReadiness.ts --help",
    "ci": "npm run contracts:check && npm run lint && npm run type-check && npm run migration:check && npm test && npm run build",
    "migrate:proposal-v1": "ts-node scripts/migrateProposalV1.ts",
    "migrate:dxg-organization": "ts-node scripts/migrateDxgOrganization.ts",
    "migrate:organization-memberships": "ts-node scripts/migrateOrganizationMemberships.ts",
    "migrate:postgres": "ts-node scripts/migratePostgres.ts",
    "backfill:postgres-proposals": "ts-node scripts/backfillPostgresProposalReferences.ts",
    "create-super-user": "ts-node scripts/createSuperUser.ts",
    "test-image-upload": "ts-node scripts/testImageUpload.ts",
    "verify:document-ingestion": "ts-node scripts/verifyDocumentIngestionE2E.ts",
    "worker:source-security": "ts-node scripts/startDurableWorker.ts",
    "worker:ai-gateway": "ts-node scripts/startAiGatewayWorker.ts",
    "worker:dispatcher": "ts-node scripts/startDurableDispatcher.ts",
    "verify:durable-jobs": "ts-node scripts/verifyDurableJobsE2E.ts",
    "verify:knowledge-ingestion": "ts-node scripts/verifyKnowledgeIngestionE2E.ts",
    "verify:knowledge-review": "ts-node scripts/verifyKnowledgeReviewE2E.ts",
    "verify:knowledge-retrieval": "ts-node scripts/verifyKnowledgeRetrievalE2E.ts",
    "verify:proposal-context": "ts-node scripts/verifyProposalContextE2E.ts",
    "eval:assistant": "ts-node scripts/platformAssistantEval.ts",
    "eval:assistant:live": "ts-node scripts/platformAssistantEval.ts --live",
    "retention:assistant": "ts-node scripts/cleanupAssistantRetention.ts",
    "release:assistant:check": "ts-node scripts/checkAssistantReleaseReadiness.ts",
    "verify:auth-refresh": "ts-node scripts/verifyAuthRefreshE2E.ts",
    "verify:candidate-application": "ts-node scripts/verifyCandidateApplicationE2E.ts",
    "verify:candidate-application-safety": "ts-node scripts/verifyCandidateApplicationSafetyE2E.ts",
    "observability:up": "docker compose -p rfpilotobs -f deploy/observability/docker-compose.yml up -d",
    "observability:down": "docker compose -p rfpilotobs -f deploy/observability/docker-compose.yml down -v",
    "integration:up": "docker compose -p rfpilotintg -f deploy/integration/docker-compose.yml up -d --wait",
    "integration:down": "docker compose -p rfpilotintg -f deploy/integration/docker-compose.yml down -v",
    "test:integration": "INTEGRATION=1 node --test --require ts-node/register --test-concurrency=1 tests-integration/*.test.ts",
    "dev:worker": "nodemon --quiet --watch src --watch config --watch modal --watch contracts --ext ts --exec ts-node scripts/startDurableWorker.ts",
    "dev:dispatcher": "nodemon --quiet --watch src --watch config --ext ts --exec ts-node scripts/startDurableDispatcher.ts",
    "verify:retention-sweep": "ts-node scripts/verifyRetentionSweepE2E.ts"
  },
  "keywords": [
    "express",
    "typescript",
    "nodejs",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1007.0",
    "@aws-sdk/s3-request-presigner": "^3.1090.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.220.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.220.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.220.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-logs": "^0.220.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.80.9",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "google-auth-library": "^10.9.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.3",
    "openai": "^6.47.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "resend": "^6.10.0",
    "sharp": "^0.34.5",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.10.6",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.20.0",
    "@vercel/node": "^3.0.0",
    "eslint": "^10.7.0",
    "json-schema-to-typescript": "^15.0.4",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.64.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "fast-uri": "^3.1.4"
  }
}
