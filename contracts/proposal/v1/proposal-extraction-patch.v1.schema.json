{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rfpilot.dxg.com/contracts/proposal/v1/proposal-extraction-patch.v1.schema.json",
  "title": "ProposalExtractionPatchV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "proposalId", "proposalVersion", "sourceVersionIds", "candidates"],
  "properties": {
    "schemaVersion": { "const": "proposal-extraction-patch.v1" },
    "proposalId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "proposalVersion": { "type": "integer", "minimum": 1 },
    "sourceVersionIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 128 },
      "minItems": 1,
      "uniqueItems": true
    },
    "candidates": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/candidate" }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "value", "evidence", "confidence", "state", "validation"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/content(?:/[A-Za-z0-9_~-]+)+$",
          "maxLength": 1000
        },
        "value": {},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "state": {
          "type": "string",
          "enum": ["pending", "accepted", "modified", "rejected"]
        },
        "conflict": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "description"],
          "properties": {
            "kind": { "type": "string", "enum": ["source_conflict", "ambiguous", "stale", "unsupported"] },
            "description": { "type": "string", "minLength": 1, "maxLength": 2000 }
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["valid"],
          "properties": {
            "valid": { "type": "boolean" },
            "issues": {
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceVersionId", "fragmentId"],
      "properties": {
        "sourceVersionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "fragmentId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "page": { "type": "integer", "minimum": 1 },
        "startOffset": { "type": "integer", "minimum": 0 },
        "endOffset": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
