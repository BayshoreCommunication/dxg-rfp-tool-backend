{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rfpilot.com/contracts/vendor-response-validation-error.v1.schema.json",
  "title": "VendorResponseValidationEnvelopeV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "valid", "errors"],
  "properties": {
    "schemaVersion": { "const": "vendor-response-validation-error.v1" },
    "valid": { "const": false },
    "errors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "path", "sectionId", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1, "maxLength": 100 },
          "path": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "sectionId": { "type": "string", "minLength": 1, "maxLength": 100 },
          "message": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    }
  }
}
